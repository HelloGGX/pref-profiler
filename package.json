{
  "name": "perf-profiler",
  "version": "1.0.0",
  "description": "Standalone checkpoint-based performance profiler extracted from the Claude Code source snapshot (startupProfiler / queryProfiler / headlessProfiler / profilerBase).",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "license": "MIT",
  "bin": {
    "perf-profiler": "./bin/perf-profiler"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --minify --outfile ./bin/perf-profiler",
    "build:dev": "bun build ./src/cli.ts --compile --outfile ./bin/perf-profiler",
    "dev": "bun run ./src/cli.ts",
    "start": "bun run ./src/cli.ts",
    "test": "bun test ./test/smoke.test.js"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
