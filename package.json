{
  "name": "perf-profiler",
  "version": "1.0.0",
  "description": "Checkpoint-based performance profiler for harness engineering. Emits human-readable and AI-friendly JSON reports with detected anomalies and fix suggestions.",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "license": "MIT",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "perf-profiler": "./bin/perf-profiler"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --minify --outfile ./bin/perf-profiler",
    "build:dev": "bun build ./src/cli.ts --compile --outfile ./bin/perf-profiler",
    "dev": "bun run ./src/cli.ts",
    "start": "bun run ./src/cli.ts",
    "test": "bun test ./test/"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
