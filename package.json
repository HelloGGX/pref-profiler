{
  "name": "perf-profiler",
  "version": "1.0.0",
  "description": "Standalone checkpoint-based performance profiler extracted from the Claude Code source snapshot (startupProfiler / queryProfiler / headlessProfiler / profilerBase).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "perf-profiler": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/cli.js",
    "test": "node --test test/smoke.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
