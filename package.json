{
  "name": "perf-profiler",
  "version": "1.0.0",
  "description": "Checkpoint-based performance profiler for harness engineering. Emits human-readable and AI-friendly JSON reports with detected anomalies and fix suggestions.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "perf": "dist/cli.js",
    "perf-profiler": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README-zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node dist/cli.js",
    "start": "node dist/cli.js",
    "playground": "bash playground/run-all.sh",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloGGX/pref-profiler.git"
  },
  "bugs": {
    "url": "https://github.com/HelloGGX/pref-profiler/issues"
  },
  "homepage": "https://github.com/HelloGGX/pref-profiler#readme",
  "keywords": [
    "performance",
    "profiler",
    "startup",
    "latency",
    "perf-hooks",
    "benchmark",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
